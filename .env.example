# Server & Frontend configuration
PORT=3000
BASE_PATH=/
LOG_LEVEL=info

# PostgreSQL (optional — falls back to in-memory store when unset)
DATABASE_URL=

# Clerk Authentication (optional — falls back to local guest preview mode when unset)
CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
VITE_CLERK_PUBLISHABLE_KEY=
VITE_CLERK_PROXY_URL=

# Zero-cost AI provider configuration (blocked by default under zero-cost policy)
YMS_AI_PROVIDER=none
YMS_LOCAL_AI_BASE_URL=

# OpenAI-compatible provider credentials (server-side only; blocked unless zero-cost gate permits)
AI_INTEGRATIONS_OPENAI_BASE_URL=
AI_INTEGRATIONS_OPENAI_API_KEY=
